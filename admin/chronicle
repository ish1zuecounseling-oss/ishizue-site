<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Counselor Chronicle — 心理師 成長の書</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;700&family=Shippori+Mincho:wght@400;500;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px}
body{
  background:#0a0702;
  font-family:'Noto Serif JP',serif;
  color:#c9933a;
  min-height:100vh;
  padding:20px 12px 60px;
}

/* ── OUTER FRAME ── */
.outer{
  max-width:760px;
  margin:0 auto;
  border:2px solid #6b4f28;
  border-radius:2px;
  background:#0d0a05;
  position:relative;
}
.outer::before,.outer::after{
  content:'';
  position:absolute;inset:6px;
  border:1px solid #3d2a12;
  pointer-events:none;
  z-index:0;
}

/* ── SITE HEADER ── */
.site-header{
  background:#080502;
  border-bottom:2px solid #6b4f28;
  padding:28px 24px 20px;
  text-align:center;
  position:relative;
  z-index:1;
}
.corner{
  position:absolute;
  font-size:18px;color:#6b4f28;line-height:1;
}
.corner.tl{top:8px;left:10px}
.corner.tr{top:8px;right:10px}
.corner.bl{bottom:8px;left:10px}
.corner.br{bottom:8px;right:10px}
.site-title{
  font-family:'Shippori Mincho',serif;
  font-size:26px;font-weight:700;
  letter-spacing:0.3em;
  color:#e6b555;
}
.site-en{font-size:10px;letter-spacing:0.4em;color:#6b4f28;margin-top:4px}
.site-sub{font-size:11px;letter-spacing:0.2em;color:#8a6a3a;margin-top:8px}

/* ── GLOBAL PROGRESS ── */
.global-bar{
  background:#0a0702;
  border-bottom:1px solid #2a1f0e;
  padding:12px 24px;
  display:flex;align-items:center;gap:14px;
  position:relative;z-index:1;
}
.gl-label{font-size:10px;letter-spacing:0.2em;color:#8a6a3a;white-space:nowrap}
.gl-track{
  flex:1;height:8px;
  background:#1a1208;
  border:1px solid #3d2a12;
  border-radius:1px;overflow:hidden;
}
.gl-fill{
  height:100%;
  background:linear-gradient(to right,#8a6030,#e6b555);
  border-radius:1px;
  transition:width 1s cubic-bezier(.4,0,.2,1);
}
.gl-count{font-size:10px;color:#c9933a;white-space:nowrap;min-width:52px;text-align:right}

/* ── LEVEL SECTIONS ── */
.lv-section{
  border-bottom:1px solid #1a1208;
  position:relative;z-index:1;
}
.lv-section:last-child{border-bottom:none}

.lv-header{
  display:grid;
  grid-template-columns:5px 60px 1fr auto;
  align-items:stretch;
  cursor:pointer;
  background:#0d0a05;
  transition:background 0.15s;
}
.lv-header:hover{background:#130e06}

.lv-accent{width:5px}
.lv-icon-box{
  width:60px;
  display:flex;align-items:center;justify-content:center;
  font-size:22px;
  border-right:1px solid #1a1208;
  padding:14px 0;
  transition:background 0.3s;
}
.lv-meta{padding:14px 16px}
.lv-num-row{font-size:9px;letter-spacing:0.18em;margin-bottom:3px}
.lv-name{
  font-family:'Shippori Mincho',serif;
  font-size:16px;font-weight:700;letter-spacing:0.08em;margin-bottom:4px;
  color:#e6b555;
}
.lv-done-count{font-size:10px;letter-spacing:0.1em;color:#7a6040}
.lv-right{
  padding:14px 18px 14px 10px;
  display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:5px;
}
.lv-pct{font-size:18px;font-weight:700}
.lv-mini-bar{width:72px;height:4px;background:#1a1208;border:0.5px solid #3d2a12;border-radius:1px;overflow:hidden}
.lv-mini-fill{height:100%;border-radius:1px;transition:width 0.6s ease}
.lv-chev{font-size:9px;color:#5a4020;transition:transform 0.22s}
.lv-chev.open{transform:rotate(90deg)}

/* ── BODY ── */
.lv-body{background:#100c06}

/* monologue */
.mono-wrap{
  background:#080502;
  border-top:1px solid #2a1f0e;
  border-bottom:2px solid #6b4f28;
  padding:18px 24px;
  position:relative;
}
.mono-corn{position:absolute;font-size:12px;color:#6b4f28}
.mono-corn.tl{top:6px;left:8px}
.mono-corn.tr{top:6px;right:8px}
.mono-corn.bl{bottom:6px;left:8px}
.mono-corn.br{bottom:6px;right:8px}
.mono-text{
  font-size:13px;line-height:2.1;
  color:#c9aa70;text-align:center;
  font-style:italic;letter-spacing:0.04em;
  padding:2px 12px;
}

/* mastery */
.mastery-block{
  border-bottom:1px solid #1a1208;
  padding:16px 20px;
  background:#0d0a05;
}
.block-title{
  font-size:9px;letter-spacing:0.25em;color:#6b4f28;
  margin-bottom:10px;
  display:flex;align-items:center;gap:8px;
}
.block-title::before,.block-title::after{content:'─────';opacity:0.35;flex:1;overflow:hidden}
.cond-item{
  display:flex;align-items:flex-start;gap:8px;
  padding:5px 4px;
  font-size:12px;line-height:1.65;color:#a08050;
}
.cond-diamond{color:#c9933a;flex-shrink:0;font-size:10px;margin-top:3px}

/* support */
.support-block{
  border-bottom:1px solid #1a1208;
  padding:16px 20px;
  background:#0f0b05;
}
.sup-card{
  background:#0d0a05;
  border:1px solid #2a1f0e;
  border-radius:2px;
  padding:12px 14px;
  margin-bottom:8px;
  font-size:12px;line-height:1.75;color:#a08050;
}
.sup-card:last-child{margin-bottom:0}
.sup-cat{
  display:inline-block;
  font-size:9px;letter-spacing:0.15em;
  background:#2a1f0e;color:#c9933a;
  padding:2px 8px;border-radius:1px;
  margin-bottom:6px;
}
.sup-card b{color:#e6b555;font-weight:500}

/* tasks */
.tasks-block{padding:16px 20px 20px;background:#0d0a05}
.task-cat-label{
  font-size:9px;letter-spacing:0.22em;color:#6b4f28;
  margin:12px 0 6px;
  display:flex;align-items:center;gap:6px;
}
.task-cat-label::after{content:'──────────────────';opacity:0.2;flex:1;overflow:hidden}
.task-cat-label:first-child{margin-top:0}
.task-row{
  display:flex;align-items:flex-start;gap:9px;
  padding:5px 3px;
  cursor:pointer;
  border-radius:2px;
  transition:background 0.1s;
}
.task-row:hover{background:#1a1208}
.task-row.locked-row{cursor:default;opacity:0.45}
.task-box{
  width:16px;height:16px;flex-shrink:0;margin-top:2px;
  border:1.5px solid #3d2a12;
  background:#080502;border-radius:2px;
  display:flex;align-items:center;justify-content:center;
  transition:all 0.15s;
}
.task-box.checked{background:#8a6030;border-color:#c9933a}
.task-box.checked::after{content:'✓';font-size:10px;color:#f5d080;font-weight:700;line-height:1}
.task-label{font-size:12px;line-height:1.65;color:#a08050;transition:color 0.15s}
.task-label.done{color:#4a3820;text-decoration:line-through}

/* achievement */
.ach-wrap{
  display:none;
  background:#080502;
  border-top:2px solid #c9933a;
  padding:14px 20px;
  align-items:center;gap:14px;
}
.ach-wrap.show{display:flex}
.ach-star{font-size:26px;color:#e6b555;animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.6}}
.ach-title{font-family:'Shippori Mincho',serif;font-size:14px;font-weight:700;color:#e6b555;letter-spacing:0.08em}
.ach-sub{font-size:10px;letter-spacing:0.12em;color:#8a6a3a;margin-top:3px}

/* locked notice */
.locked-notice{
  border-top:1px solid #1a1208;
  padding:16px;text-align:center;
  font-size:11px;letter-spacing:0.1em;color:#3d2a12;
  background:#0a0702;
}

/* ── FOOTER ── */
.site-footer{
  border-top:2px solid #3d2a12;
  padding:12px 24px;
  text-align:center;
  font-size:10px;letter-spacing:0.15em;color:#3d2a12;
  background:#080502;
  position:relative;z-index:1;
}
</style>
</head>
