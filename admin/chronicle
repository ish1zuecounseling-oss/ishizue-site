const KEY = 'cc_v3';
let state = {};
try{ state = JSON.parse(localStorage.getItem(KEY)||'{}'); }catch(e){}
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }

function countAll(lv){ return Object.values(lv.tasks).flat().length; }
function countDone(lv){
  const s = state[lv.id]||{};
  return Object.values(s).filter(Boolean).length;
}

function updateGlobal(){
  let total=0, done=0;
  LEVELS.forEach(lv=>{ total+=countAll(lv); done+=countDone(lv); });
  const pct = total>0 ? Math.round(done/total*100) : 0;
  document.getElementById('gfill').style.width = pct+'%';
  document.getElementById('gcnt').textContent = done+' / '+total;
}

// Track which sections are open
const openSections = new Set();

function renderAll(){
  const root = document.getElementById('root');
  root.innerHTML = '';
  LEVELS.forEach((lv, idx) => buildCard(lv, idx, root));
}

function buildCard(lv, idx, root){
  const total = countAll(lv);
  const done = countDone(lv);
  const pct = total>0 ? Math.round(done/total*100) : 0;
  const allDone = done===total;
  const prevDone = idx===0 || countDone(LEVELS[idx-1])===countAll(LEVELS[idx-1]);
  const isOpen = openSections.has(lv.id);

  const sec = document.createElement('div');
  sec.className = 'lv-section';
  sec.id = 'sec-'+lv.id;

  // Header
  const hdr = document.createElement('div');
  hdr.className = 'lv-header';
  hdr.innerHTML = `
    <div class="lv-accent" style="background:${lv.accent}"></div>
    <div class="lv-icon-box" style="color:${lv.accent};background:${allDone?lv.light:'#0a0702'}">${lv.icon}</div>
    <div class="lv-meta">
      <div class="lv-num-row" style="color:${lv.accent}">${lv.num}　·　${lv.title}</div>
      <div class="lv-name" style="color:${allDone?lv.accent:'#e6b555'}">${lv.name}</div>
      <div class="lv-done-count">${done} / ${total} 項目習得</div>
    </div>
    <div class="lv-right">
      <div class="lv-pct" style="color:${lv.accent}">${pct}%</div>
      <div class="lv-mini-bar"><div class="lv-mini-fill" style="width:${pct}%;background:${lv.accent}"></div></div>
      <div class="lv-chev ${isOpen?'open':''}" id="chev-${lv.id}">▶</div>
    </div>
  `;

  // Body
  const body = document.createElement('div');
  body.className = 'lv-body';
  body.id = 'body-'+lv.id;
  body.style.display = isOpen ? 'block' : 'none';

  // Monologue
  const monoLines = lv.monologue.split('\n').map(l=>`<div>${l}</div>`).join('');

  // Mastery conditions
  const condHtml = lv.masteryConditions.map(c=>
    `<div class="cond-item"><span class="cond-diamond">◆</span><span>${c}</span></div>`
  ).join('');

  // Support cards
  const supHtml = lv.supports.map(s=>
    `<div class="sup-card"><div class="sup-cat">${s.cat}</div>${s.body}</div>`
  ).join('');

  // Task rows
  let tasksHtml = '';
  Object.entries(lv.tasks).forEach(([cat, items])=>{
    tasksHtml += `<div class="task-cat-label">${cat}</div>`;
    items.forEach((text, i)=>{
      const key = `${cat}_${i}`;
      const checked = !!(state[lv.id]||{})[key];
      const lockedRow = !prevDone;
      tasksHtml += `
        <div class="task-row${lockedRow?' locked-row':''}" data-lv="${lv.id}" data-key="${key}">
          <div class="task-box ${checked?'checked':''}"></div>
          <div class="task-label ${checked?'done':''}">${text}</div>
        </div>`;
    });
  });

  // Achievement
  const achHtml = allDone ? `
    <div class="ach-wrap show">
      <div class="ach-star">★</div>
      <div>
        <div class="ach-title">${lv.name}　完全習得</div>
        <div class="ach-sub">― 「${lv.title}」の称号を獲得 ―</div>
      </div>
    </div>` : '';

  const lockedHtml = !prevDone
    ? `<div class="locked-notice">── 前の等級を完全習得すると解放される ──</div>` : '';

  body.innerHTML = `
    <div class="mono-wrap">
      <div class="mono-corn tl">✦</div><div class="mono-corn tr">✦</div>
      <div class="mono-corn bl">✦</div><div class="mono-corn br">✦</div>
      <div class="mono-text">${monoLines}</div>
    </div>
    <div class="mastery-block">
      <div class="block-title">習得条件</div>
      ${condHtml}
    </div>
    <div class="support-block">
      <div class="block-title">習得へのサポート</div>
      ${supHtml}
    </div>
    <div class="tasks-block">${tasksHtml}</div>
    ${achHtml}
    ${lockedHtml}
  `;

  // Header click: toggle open/close without re-render
  hdr.addEventListener('click', ()=>{
    const b = document.getElementById('body-'+lv.id);
    const c = document.getElementById('chev-'+lv.id);
    const nowOpen = b.style.display === 'block';
    if(nowOpen){
      b.style.display = 'none';
      c.classList.remove('open');
      openSections.delete(lv.id);
    } else {
      b.style.display = 'block';
      c.classList.add('open');
      openSections.add(lv.id);
    }
  });

  // Task click: update state, re-render only the progress parts (NOT the body)
  body.querySelectorAll('.task-row:not(.locked-row)').forEach(row=>{
    row.addEventListener('click', e=>{
      const lvId = row.dataset.lv;
      const key = row.dataset.key;
      if(!state[lvId]) state[lvId] = {};
      state[lvId][key] = !state[lvId][key];
      save();

      // Update this checkbox in-place
      const box = row.querySelector('.task-box');
      const label = row.querySelector('.task-label');
      const nowChecked = state[lvId][key];
      box.classList.toggle('checked', nowChecked);
      label.classList.toggle('done', nowChecked);

      // Recalculate progress for this card header (in-place)
      const lvData = LEVELS.find(l=>l.id===lvId);
      const newDone = countDone(lvData);
      const newTotal = countAll(lvData);
      const newPct = Math.round(newDone/newTotal*100);
      const secEl = document.getElementById('sec-'+lvId);
      secEl.querySelector('.lv-done-count').textContent = newDone+' / '+newTotal+' 項目習得';
      secEl.querySelector('.lv-pct').textContent = newPct+'%';
      secEl.querySelector('.lv-mini-fill').style.width = newPct+'%';

      // Show achievement if just completed
      const achWrap = secEl.querySelector('.ach-wrap');
      if(achWrap) achWrap.classList.toggle('show', newDone===newTotal);

      updateGlobal();
    });
  });

  sec.appendChild(hdr);
  sec.appendChild(body);
  root.appendChild(sec);
}

renderAll();
updateGlobal();
</script>
