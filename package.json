{
  "name": "ishizue-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "generate:articles": "tsx scripts/generateArticles.ts",
    "generate:sitemap": "tsx scripts/generateSitemap.ts",
    "build": "npm run generate:articles && npm run generate:sitemap && vite build",
